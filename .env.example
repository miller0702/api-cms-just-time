# Postgres por partes (recomendado). Prisma arma DATABASE_URL al arrancar.
DB_HOST=aws-0-ca-central-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.alqwmjifjjvqazaxncrx
DB_PASSWORD=YOUR_PASSWORD
DB_SCHEMA=cms
DB_SSLMODE=require
# Transaction pooler (evita EMAXCONNSESSION del modo Session)
DB_PGBOUNCER=true
DB_CONNECTION_LIMIT=5
# Migraciones Prisma usan Session en este puerto
DB_MIGRATE_PORT=5432
# Opcional: si defines DATABASE_URL completa, tiene prioridad solo si faltan DB_HOST/DB_USER.
# DATABASE_URL="postgresql://..."

JWT_SECRET="just-time-cms-dev-secret-change-me"
JWT_EXPIRES_IN="8h"
PORT=3002
ADMIN_EMAIL="admin@justtime.co"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Administrador CMS"
CORS_ORIGIN="http://localhost:5173"

# Media → GCS (prod). Sin GCS_BUCKET → disco local ./uploads
GCS_BUCKET=just-time-media-prod
GCS_PROJECT_ID=just-time-sas
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/just-time-media-prod

# Firebase Admin — variables de entorno (recomendado en Cloud Run / Secret Manager).
# La private key va en una sola línea con \n escapados.
FIREBASE_PROJECT_ID=just-time-sas
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@just-time-sas.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Fallback local opcional (archivo JSON; no usar en prod)
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json

# Reglas Firestore sugeridas (colección admin_notifications):
#   match /admin_notifications/{id} {
#     allow read, update: if request.auth != null;
#     allow create, delete: if false;
#   }

# OpenAI — Generación de contenido con IA
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ERP admin-api (vitrina Urbanismo: mapa / lotes / leads)
# Ejemplo local: http://localhost:3003
ERP_API_BASE_URL=http://localhost:3003

# Correo de avisos de leads (RF-CMS-LEAD-002). Sin SMTP_HOST solo hay aviso in-app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@justtimesas.com
SMTP_PASSWORD=app-password
MAIL_FROM="Just Time <notificaciones@justtimesas.com>"

# Buzón por tipo de solicitud; LEADS_EMAIL_DEFAULT cubre los que no tengan uno propio.
LEADS_EMAIL_DEFAULT=administracion@justtimesas.com
LEADS_EMAIL_CONTACT=comercial@justtimesas.com
LEADS_EMAIL_PQRS=pqrs@justtimesas.com
LEADS_EMAIL_FLEET=flota@justtimesas.com
LEADS_EMAIL_LOT=urbanismo@justtimesas.com

# Lista spam adicional (también editable en /admin/leads → Lista spam)
LEADS_SPAM_EMAILS=
LEADS_SPAM_DOMAINS=
LEADS_SPAM_PHONES=

# Enlaces dentro de los correos
ADMIN_SITE_URL=https://justtimesas.com
PUBLIC_SITE_URL=https://justtimesas.com
