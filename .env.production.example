# Credenciales / endpoints de producción para correr la API en local.
# Uso: pnpm dev:prod
# Nunca commits este archivo (está en .gitignore).

DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SCHEMA=cms
DB_SSLMODE=require
DB_PGBOUNCER=true
DB_CONNECTION_LIMIT=5
DB_MIGRATE_PORT=5432

JWT_SECRET=
JWT_EXPIRES_IN=8h
PORT=3002
CORS_ORIGIN=http://localhost:5173

GCS_BUCKET=just-time-media-prod
GCS_PROJECT_ID=just-time-sas
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/just-time-media-prod

FIREBASE_PROJECT_ID=just-time-sas
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=
ERP_API_BASE_URL=https://TU-ERP-API.run.app
